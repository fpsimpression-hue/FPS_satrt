POSTGRES_DB=fastprint
POSTGRES_USER=fastprint
POSTGRES_PASSWORD=change-me-before-deployment
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
MAX_UPLOAD_SIZE_BYTES=26214400
NEXT_PUBLIC_API_URL=http://localhost:8000
ADMIN_USERNAME=admin
# Generate with: python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('your-password'))"
# Keep the single quotes when pasting the generated hash; it contains dollar signs.
ADMIN_PASSWORD_HASH='replace-with-an-argon2id-password-hash'
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set true behind HTTPS in production.
ADMIN_COOKIE_SECURE=false
# WhatsApp Cloud API; leave empty until Meta credentials and approved templates are ready.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_FR=
WHATSAPP_TEMPLATE_AR=
WHATSAPP_TEMPLATE_EN=
WHATSAPP_MAX_ATTEMPTS=8
